APP_NAME="SKL GRAND ROOMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost/HNP/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hnp_hotel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@sklgrandrooms.test"
MAIL_FROM_NAME="${APP_NAME}"

# SMS Gateway for Android (sms-gate.app). The username, password and local
# server address are shown inside the app on the hotel phone.
# mode: cloud = via api.sms-gate.app (works anywhere, use this live)
#       local = phone on the same Wi-Fi as this site
# The URL is only needed for local mode. Cloud and local have DIFFERENT logins.
SMS_GATEWAY_MODE=cloud
SMS_GATEWAY_URL=
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
SMS_DAILY_LIMIT=95

# One way hash of the SMS Marketing access code (never the code itself).
# Make one with: php artisan tinker --execute="echo password_hash('YOURCODE', PASSWORD_BCRYPT);"
SMS_ACCESS_CODE_HASH=
